---
import LeadershipDocument from '../../../layouts/LeadershipDocument.astro';
import content from '../../../data/leadership.json';
---
<LeadershipDocument title="Masjidee leadership briefing" description="A presentation for Jamaat leadership on member value, learning, organization and a responsible pilot." presentation>
 <div class="deck-intro"><p class="document-eyebrow">Leadership presentation · 16 slides</p><h1>Masjidee: leadership briefing</h1><p>A member-centered pilot connecting mosque life, religious learning and responsible participation insights.</p><div class="document-actions"><a class="document-button" href="/docs/leadership/masjidee-leadership-presentation.pptx" download>Download PowerPoint ↓</a><a class="print-button" href="/docs/leadership/masjidee-leadership-presentation.pdf" download>Download PDF ↓</a><button class="print-button" id="fullscreen">Present fullscreen</button></div><p class="presentation-help">Use ← and → to move between slides. Speaker notes are included in the PowerPoint and below each web slide.</p></div>
 <div class="slide-deck">{content.slides.map((slide,index)=><section class:list={['slide-section',{dark:['cover','closing'].includes(slide.kind)}]} id={`slide-${index+1}`}><div class="web-slide"><div class="slide-top"><span>MASJIDEE</span><span>{slide.kicker}</span></div><h2>{slide.title.split('\n').map((line,i)=><Fragment>{i>0&&<br/>}{line}</Fragment>)}</h2>{'flow' in slide&&slide.flow&&<div class="slide-flow">{slide.flow.map((item,i)=><Fragment><span>{item}</span>{i<slide.flow!.length-1&&<b aria-hidden="true">→</b>}</Fragment>)}</div>}{slide.kind==='hierarchy'&&<div class="hierarchy-path"><span>Global Jamaat / AMI</span><span>National Jamaat · USA</span><span>Local chapter · Oshkosh</span><span>Membership groups → individuals</span></div>}<ul class:list={{'slide-cards':slide.kind==='three'}}>{slide.points.map(point=><li>{point}</li>)}</ul><div class="slide-bottom"><span>PROOF OF CONCEPT / PILOT · DISCUSSION DRAFT</span><span>{String(index+1).padStart(2,'0')} / {content.slides.length}</span></div></div><details class="speaker-notes"><summary>Presenter notes</summary><p>{slide.notes}</p></details></section>)}</div>
 <script>
  document.querySelector('#fullscreen')?.addEventListener('click',()=>document.documentElement.requestFullscreen?.());
  document.addEventListener('keydown',event=>{if(!['ArrowLeft','ArrowRight'].includes(event.key)||(event.target instanceof HTMLElement&&['INPUT','TEXTAREA','BUTTON'].includes(event.target.tagName)))return;event.preventDefault();const slides=[...document.querySelectorAll<HTMLElement>('.slide-section')];const current=slides.reduce((best,slide,i)=>Math.abs(slide.getBoundingClientRect().top)<Math.abs(slides[best].getBoundingClientRect().top)?i:best,0);slides[Math.max(0,Math.min(slides.length-1,current+(event.key==='ArrowRight'?1:-1)))]?.scrollIntoView({behavior:'smooth',block:'start'});});
 </script>
</LeadershipDocument>
